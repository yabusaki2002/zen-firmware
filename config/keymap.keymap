#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <120>;
};

/ {
    combos {
        compatible = "zmk,combos";

        blt_setting {
            bindings = <&mo 6>;
            key-positions = <31 45>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        cmd_tab_hold: cmd_tab_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_press>,
                <&mo 7>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 7>,
                <&macro_release>,
                <&kp LGUI>;
        };

        ctrl_tab_hold: ctrl_tab_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_press>,
                <&mo 8>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 8>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E         &kp R         &kp T      &kp Y      &kp U        &kp I  &kp O  &kp P      &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D         &kp F         &kp G      &kp H      &kp J        &kp K  &kp L  &kp SEMI   &kp APOS
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V         &kp B      &none      &none        &kp N  &kp M  &kp COMMA  &kp DOT   &kp SLASH  &none
&kp LCTRL  &none  &none  &lt 1 ESCAPE  &kp LEFT_GUI  &lt 2 ESC  &kp SPACE  &lt 3 ENTER  &none  &none  &none      &none
            >;
        };

        function_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp F1  &kp F2  &kp F3   &kp F4   &kp F5   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10  &none
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB2  &mkp MB1  &kp F11  &kp F12  &trans   &trans  &none  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans   &none
            >;
        };

        symbol_layer {
            bindings = <
&kp GRAVE  &none  &none           &kp UP_ARROW    &none            &none   &kp AMPERSAND    &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS         &kp EQUAL
&none      &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none   &kp EXCLAMATION  &kp AT_SIGN    &kp HASH              &kp PERCENT            &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans     &none  &none           &none           &none            &none   &none            &none          &kp CARET             &none                  &none             &none              &none  &trans
&trans     &none  &trans          &trans          &kp LCMD         &trans  &trans           &kp LG(SPACE)  &kp RIGHT_COMMAND     &trans                 &trans            &kp PERCENT
            >;
        };

        number_layer {
            bindings = <
&trans  &none   &kp N7        &kp N8  &kp N9  &trans  &trans     &trans     &trans  &trans  &trans  &kp BACKSPACE
&none   &none   &kp NUMBER_4  &kp N5  &kp N6  &trans  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &none   &kp N1        &kp N2  &kp N3  &kp N0  &trans     &trans     &trans  &trans  &trans  &kp COMMA      &kp DOT  &trans
&trans  &trans  &trans        &trans  &trans  &trans  &kp SPACE  &kp ENTER  &none   &trans  &trans  &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans    &trans    &mkp MB4  &mkp MB5  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &lt 5 ESC  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans        &trans        &trans        &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans        &bootloader   &trans        &trans        &trans        &trans          &bt BT_CLR  &trans
&trans  &trans  &trans        &trans        &trans        &trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        cmd_tab_layer {
            bindings = <
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        ctrl_tab_layer {
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
